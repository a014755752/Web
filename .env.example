# 仅在服务端使用；DeepSeek Flash、Search、Fetch 和 OCR 共用此密钥。
DEEPSEEK_API_KEY=

# 可选：接入 OpenAI 兼容模型服务。
# 兼容接口密钥与地址；同时填写后可切换服务商。
MODEL_API_KEY=
MODEL_BASE_URL=
# 文本、视觉、向量模型名称；留空使用服务商默认值。
# DeepSeek 模式不调用向量模型，规则检索使用 Flash 语义匹配。
MODEL_TEXT=
MODEL_VISION=
MODEL_EMBEDDING=
# 可选：阿里云 DashScope 兼容服务密钥。
DASHSCOPE_API_KEY=
